# Resend (app-level transactional email)
# Create an API key at https://resend.com/api-keys and set it here + in Vercel.
RESEND_API_KEY=re_xxxxxxxxx
# Optional. Until cignalsystem.com is verified in Resend, leave this unset
# (sends fall back to onboarding@resend.dev). After verifying the domain:
# RESEND_FROM=noreply@cignalsystem.com
RESEND_FROM=

# Stripe (billing). Test keys for sandbox, live keys at go-live.
# Secret key from Stripe Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret from the webhook endpoint (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Social profile URLs — leave blank to fall back to the platform home page.
# Set these to point the footer + floating rail at the real Cignal profiles.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
